// Cloudflare: Worker "manikun". Statyczne pliki strony + serwer dla adresów /api/* (server/index.js).
// Wdraża się sam z gita (Workers Builds) po każdym pushu na gałąź produkcyjną.
// Sekrety (panel: Settings › Variables and Secrets): GOOGLE_CLIENT_SECRET, HF_KEY (Higgsfield, KEY_ID:KEY_SECRET).
// Strony (/, regulamin, prywatnosc, zwroty) też przechodzą przez serwer: przekierowanie na adres główny (CANONICAL_HOST).
// Opcjonalnie zmienne: HF_MODEL (domyślnie higgsfield-ai/soul/v2/standard), GEN_COST (kredyty za zdjęcie, domyślnie 1).
{
  "name": "manikun",
  "main": "server/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Domena główna (strefa manikun.pl w Cloudflare); www i workers.dev przekierowują na nią (CANONICAL_HOST w server/index.js)
  "routes": [
    { "pattern": "manikun.pl", "custom_domain": true },
    { "pattern": "www.manikun.pl", "custom_domain": true }
  ],
  "assets": { "directory": "./", "binding": "ASSETS", "run_worker_first": ["/api/*", "/", "/index.html", "/cennik", "/regulamin", "/prywatnosc", "/zwroty"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "manikun", "database_id": "cbafedec-9882-4949-b1f8-5ce6af761402", "migrations_dir": "migrations" }
  ],
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    { "binding": "PHOTOS", "id": "3e64de3dd30e4f26a76469c51564d3bd" }
  ],
  "vars": { "CANONICAL_HOST": "manikun.pl", "GOOGLE_CLIENT_ID": "331864294353-thj64786rfai33kid9v7sbahg52vicb3.apps.googleusercontent.com" },
  "observability": { "enabled": true }
}
